{
  "llm": {
    "provider": "ollama",
    "config": {
      "api_url": "${OLLAMA_API_URL}",
      "model_name": "gemma4:31b-cloud",
      "strategy": "json",
      "temperature": 0.1,
      "top_p": 0.8,
      "num_ctx": 32768
    }
  },
  "testing": {
    "provider": "floci",
    "config": {
      "endpoint": "${FLOCI_ENDPOINT}",
      "region": "${FLOCI_REGION}",
      "account_id": "${FLOCI_ACCOUNT_ID}",
      "function_name": "${FLOCI_FUNCTION_NAME}",
      "lambda_timeout_seconds": 10,
      "lambda_memory_mb": 128,
      "test_prefix": "test/floci/",
      "test_suffixes": [".floci.json", ".floci.yaml", ".floci.yml"]
    }
  },
  "pipeline": {
    "options": {
      "floci_enabled": true
    },
    "tasks": [
      {
        "id": "root",
        "task": "flociTester",
        "maxRetryCount": 1
      }
    ]
  }
}
