# Example environment variables for running the service with Docker Compose.
# Copy to `.env` and edit the values before running `docker compose up`.

# URL for an Ollama-compatible LLM endpoint (when run via compose use the service name)
# When using the included Ollama service this should point to: http://ollama:11434
OLLAMA_API_URL=http://host.docker.internal:11434

# Gemini API key (if using the Gemini backend)
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash

# AcademicCloud API key (if using the Chat AI backend)
ACADEMIC_CLOUD_ENDPOINT=https://chat-ai.academiccloud.de/v1
ACADEMIC_CLOUD_API_KEY=REPLACE_WITH_YOUR_ACADEMIC_CLOUD_KEY

# Application port (container exposes 8080 by default)
APP_PORT=8080

# Optional Floci integration (local AWS emulator for Lambda integration tests).
# Leave FLOCI_ENABLED unset/false to keep the feature off; the flociTester
# pipeline stage then no-ops. Start the emulator with `docker compose
# --profile floci up` and set FLOCI_ENABLED=true to deploy/test translated
# functions against it. See docs/floci-integration.md.
FLOCI_ENABLED=false
FLOCI_ENDPOINT=http://floci:4566
FLOCI_REGION=us-east-1

# Other optional runtime flags
#LOG_LEVEL=debug