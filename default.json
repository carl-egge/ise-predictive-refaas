{
  "LLMClient": "ollama",
  "args": {
    "OLLAMA_API_URL": "http://ollama:11434"
  },
  "pipeline": {
    "options": {
      "model_name": "qwen2.5-coder:3b",
      "strategy": "json",
      "temperature": 0.1,
      "top_p": 0.8,
      "num_ctx": 32768,
      "floci_enabled": false,
      "floci_endpoint": "http://localhost:4566",
      "floci_region": "us-east-1",
      "floci_account_id": "000000000000",
      "floci_function_name": "refaas-translated",
      "floci_lambda_timeout_seconds": 10,
      "floci_lambda_memory_mb": 128,
      "floci_test_prefix": "test/floci/",
      "floci_test_suffixes": [".floci.json", ".floci.yaml", ".floci.yml"]
    },
    "tasks": [
      {
        "id": "root",
        "task": "cleaner",
        "maxRetryCount": 2,
        "next": ["convert"],
        "validation": "canCompile"
      },
      {
        "id": "convert",
        "task": "coder",
        "task_args": { "reader": "go" },
        "maxRetryCount": 2,
        "validation": "canCompile",
        "next": ["builder"]
      },
      {
        "id": "builder",
        "task": "goBuilder",
        "canApply": "canCompile",
        "recovery": "gollmRecovery",
        "maxRetryCount": 4,
        "next": ["goTester"]
      },
      {
        "id": "gollmRecovery",
        "task": "fixer",
        "canApply": "canCompile",
        "task_args": { "reader": "go" },
        "maxRetryCount": 6
      },
      {
        "id": "goTester",
        "task": "goTester",
        "canApply": "canCompile",
        "maxRetryCount": 5,
        "recovery": "testRecovery",
        "next": ["flociTester"]
      },
      {
        "id": "flociTester",
        "task": "flociTester",
        "maxRetryCount": 1
      },
      {
        "id": "testRecovery",
        "task": "realign",
        "canApply": "canCompile",
        "task_args": { "reader": "go" },
        "maxRetryCount": 3,
        "next": ["testRecoveryBuild"]
      },
      {
        "id": "testRecoveryBuild",
        "canApply": "canCompile",
        "task": "goBuilder",
        "recovery": "gollmRecovery",
        "maxRetryCount": 3
      }
    ]
  }
}
